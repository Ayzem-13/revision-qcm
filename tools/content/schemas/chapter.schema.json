{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "group": {
      "type": "string",
      "minLength": 1
    },
    "order": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "questions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "single",
              "multi"
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "choices": {
            "minItems": 3,
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "answer": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "difficulty": {
            "anyOf": [
              {
                "type": "number",
                "const": 1
              },
              {
                "type": "number",
                "const": 2
              },
              {
                "type": "number",
                "const": 3
              }
            ]
          }
        },
        "required": [
          "id",
          "type",
          "prompt",
          "choices",
          "answer",
          "explanation",
          "difficulty"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "title",
    "group",
    "order",
    "source",
    "questions"
  ],
  "additionalProperties": false
}
